# =============================================================================
# Calixto Agency — environment template
# =============================================================================
# Copy to .env and fill in. NEVER commit .env — it is covered by .gitignore.
# This file must contain variable NAMES and safe placeholders ONLY.
# If you ever paste a real value here, treat that value as compromised and
# rotate it: this file is the one that gets committed.
#
# Verify a filled-in environment before booting:
#   bun run security:config                       # current profile
#   NODE_ENV=production bun run security:config   # production verdict
#
# The server refuses to start in production when a required value is missing,
# is a placeholder, or is not HTTPS. That is deliberate — see GO-LIVE.md §A.1.
# -----------------------------------------------------------------------------


# --- Runtime -----------------------------------------------------------------
# "development" or "production". This single switch controls HSTS, Secure
# cookies, opaque error messages, removal of dev-only routes, and the
# destructive-script guard. Unset means every one of those stays OFF.
NODE_ENV=development

# Public origin of the deployment, including scheme, no trailing slash.
# Drives cookie domain, the CORS allowlist and better-auth trustedOrigins.
# Must be HTTPS in production.
WEBSITE_URL=http://localhost:4200


# --- Database (Turso / libSQL) -----------------------------------------------
# SECRET. Use a SEPARATE database for production and development.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# DEVELOPMENT ONLY. Set this in a developer's local .env to the development
# database URL so the config check can PROVE prod and dev are not the same
# database. If it ever equals DATABASE_URL under NODE_ENV=production, the boot
# is refused — a proven collision is fatal, a missing value is only a warning.
# Never set this in the production secret store.
DEV_DATABASE_URL=


# --- Session and authentication ----------------------------------------------
# SECRET. Signs every session token. Minimum 32 characters; the config guard
# also measures entropy and rejects anything below ~128 bits.
# Generate with:  openssl rand -base64 48
# Rotating this invalidates all sessions — everyone signs in again.
BETTER_AUTH_SECRET=

# Runable managed-auth application identifier. Not a secret (it is a public
# identifier), but it must match the value the platform issued for this app.
APPLICATION_ID=


# --- Object storage (Tigris, S3-compatible) ----------------------------------
# S3_ENDPOINT and S3_BUCKET are not secrets. The key pair IS a secret and holds
# full access to every uploaded client document — scope it to this bucket only.
# Use a SEPARATE bucket for production and development.
S3_ENDPOINT=https://t3.storage.dev
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# --- Transactional email (password reset) ------------------------------------
# SECRET. Without these, password reset is undeliverable: in production the
# mailer throws rather than pretending to succeed. Verify your sending domain
# (SPF + DKIM) or reset mail lands in spam, which is the same as not sending it.
RESEND_API_KEY=
MAIL_FROM=Calixto Agency <noreply@yourdomain.com>


# --- Data retention ----------------------------------------------------------
# Days before client documents are deleted from storage AND the database.
# Confirm against your statutory obligations before changing — deleting
# something you are legally required to keep is worse than keeping it too long.
DOCUMENT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=400
INQUIRY_RETENTION_DAYS=730


# --- Client-exposed variables ------------------------------------------------
# WARNING: everything prefixed VITE_ is compiled into the browser bundle in
# CLEARTEXT and is readable by any visitor via view-source. Only ever put
# public identifiers here. NEVER a key, token, secret or password.
# The config guard fails the boot if a VITE_ variable has a secret-shaped name.
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=https://api.runable.com/api/auth


# --- Platform tooling (not application runtime) ------------------------------
# CONTAINS AN EMBEDDED CREDENTIAL in its query string (?key=...). It looks like
# a plain URL, which is exactly why it is easy to miss during rotation.
# Treat the whole value as a secret. Not referenced by any application code.
RUNABLE_URL=


# --- Unused / candidates for removal -----------------------------------------
# These are present in the current .env but referenced NOWHERE in application
# code. An unused credential is pure liability: it can be stolen but its loss
# is never noticed because nothing breaks. Delete them unless you are about to
# adopt the service.
#
# AI_GATEWAY_API_KEY=     # Runable AI gateway — SECRET, billable
# AI_GATEWAY_BASE_URL=    # not a secret
# AUTUMN_SECRET_KEY=      # payments — SECRET, out of scope this phase


# --- Escape hatch (never set this in a deployed environment) -----------------
# Set to 1 for a SINGLE command to allow seed/purge/restore/retention to run
# against a production NODE_ENV. Do not export it into a shell you keep using.
# ALLOW_DESTRUCTIVE=
